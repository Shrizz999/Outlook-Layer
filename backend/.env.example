# ============================================================
# Balbird Intelligence Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application ---
APP_ENV=development         # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-32-char-string
CORS_ORIGINS=http://localhost:5173

# --- AI Provider ---
# Default: mock (safe for development; no external calls)
# Set to 'openrouter' only for explicitly approved synthetic data experiments
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_REQUESTS_PER_DAY=40
OPENROUTER_MAX_REQUESTS_PER_MINUTE=15
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1800
AI_TEMPERATURE=0

# --- Email Provider ---
# FIXTURE = synthetic data only (safe)
# MICROSOFT_GRAPH = requires explicit approval from customer IT
EMAIL_PROVIDER=fixture
FIXTURE_EMAIL_DIR=../data/synthetic/emails

# --- Microsoft Graph (disabled; requires customer approval) ---
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_MAILBOX=

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.csv

# --- Background Jobs ---
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json          # json | console

# --- SECURITY NOTE ---
# In production:
# - Use a secrets manager (Azure Key Vault, AWS Secrets Manager, etc.)
# - Never put real keys in this file
# - Rotate keys regularly
# - Restrict SUPABASE_SERVICE_ROLE_KEY to backend only
